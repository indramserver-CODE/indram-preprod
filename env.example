# Copy to .env for local development. In preprod/prod these values live in
# AWS SSM Parameter Store under /indram/<env>/ and are rendered by deploy/deploy.sh.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.neon.tech/neondb?ssl=require

# ── MQTT (HiveMQ Cloud) ───────────────────────────────────────────────────
ENABLE_MQTT=false
MQTT_HOST=your-cluster.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your-hivemq-username
MQTT_PASSWORD=your-hivemq-password
MQTT_USE_TLS=true
# Unique per environment — two instances with the same id kick each other off the broker
MQTT_CLIENT_ID=evc-server-local

# ── JWT Auth ──────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ──────────────────────────────────────────────────────────────────
# "*" for local dev. Production: comma-separated list, e.g. https://app.preprod.example.com
CORS_ORIGINS=*

# ── Password reset ────────────────────────────────────────────────────────
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173

# ── AWS S3 (optional — bill PDFs) ─────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── Email — Gmail SMTP ────────────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Billing / scheduler ───────────────────────────────────────────────────
BILLING_DAY_OF_MONTH=1
ENABLE_SCHEDULER=false

# ── MQTT command auth (must match charger firmware) ───────────────────────
CMD_AUTH_TOKEN=

# ── Super admin seed (created on first start if no super_admin exists) ────
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
